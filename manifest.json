{
  "manifest_version": 3,
  "name": "Popcorn First",
  "version": "1.0.0",
  "description": "See the Rotten Tomatoes audience Popcornmeter instead of the Tomatometer in Google results. Not affiliated with Rotten Tomatoes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Popcorn First"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.rottentomatoes.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.ca/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.com.au/search*",
        "https://www.google.ie/search*",
        "https://www.google.co.nz/search*",
        "https://www.google.co.in/search*",
        "https://www.google.com.sg/search*",
        "https://www.google.co.za/search*",
        "https://www.google.com.ph/search*",
        "https://www.google.com.my/search*",
        "https://www.google.com.pk/search*",
        "https://www.google.com.ng/search*",
        "https://www.google.de/search*",
        "https://www.google.fr/search*",
        "https://www.google.es/search*",
        "https://www.google.it/search*",
        "https://www.google.nl/search*",
        "https://www.google.be/search*",
        "https://www.google.ch/search*",
        "https://www.google.at/search*",
        "https://www.google.se/search*",
        "https://www.google.no/search*",
        "https://www.google.dk/search*",
        "https://www.google.fi/search*",
        "https://www.google.pl/search*",
        "https://www.google.pt/search*",
        "https://www.google.com.br/search*",
        "https://www.google.com.mx/search*",
        "https://www.google.com.ar/search*",
        "https://www.google.co.jp/search*",
        "https://www.google.co.kr/search*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/popcorn-full.svg",
        "icons/popcorn-spilled.svg"
      ],
      "matches": [
        "https://www.google.com/*",
        "https://www.google.ca/*",
        "https://www.google.co.uk/*",
        "https://www.google.com.au/*",
        "https://www.google.ie/*",
        "https://www.google.co.nz/*",
        "https://www.google.co.in/*",
        "https://www.google.com.sg/*",
        "https://www.google.co.za/*",
        "https://www.google.com.ph/*",
        "https://www.google.com.my/*",
        "https://www.google.com.pk/*",
        "https://www.google.com.ng/*",
        "https://www.google.de/*",
        "https://www.google.fr/*",
        "https://www.google.es/*",
        "https://www.google.it/*",
        "https://www.google.nl/*",
        "https://www.google.be/*",
        "https://www.google.ch/*",
        "https://www.google.at/*",
        "https://www.google.se/*",
        "https://www.google.no/*",
        "https://www.google.dk/*",
        "https://www.google.fi/*",
        "https://www.google.pl/*",
        "https://www.google.pt/*",
        "https://www.google.com.br/*",
        "https://www.google.com.mx/*",
        "https://www.google.com.ar/*",
        "https://www.google.co.jp/*",
        "https://www.google.co.kr/*"
      ]
    }
  ]
}
